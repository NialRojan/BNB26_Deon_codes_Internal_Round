datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Owner {
  id                String             @id @default(uuid())
  externalReference String             @unique
  status            String             @default("ACTIVE")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  availability      OwnerAvailability?
  heartbeatEvents   HeartbeatEvent[]
  recoveryAttempts  RecoveryAttempt[]
  alerts            Alert[]

  @@index([status])
}

model OwnerAvailability {
  id                    String    @id @default(uuid())
  ownerId               String    @unique
  state                 String    @default("ACTIVE") // ACTIVE | CHECK_IN_PENDING | MISSED | WATCH
  lastHeartbeatAt       DateTime?
  nextCheckInDueAt      DateTime?
  heartbeatIntervalDays Int       @default(30)
  gracePeriodDays       Int       @default(7)
  missedCount           Int       @default(0)
  stateReason           String?
  updatedAt             DateTime  @updatedAt

  owner                 Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([state])
  @@index([nextCheckInDueAt])
}

model HeartbeatEvent {
  id              String   @id @default(uuid())
  ownerId         String
  channel         String   // WHATSAPP | PUSH | EMAIL | APP_CHECKIN | etc.
  eventType       String   // SCHEDULED_PING | MANUAL_CHECKIN | APP_FOREGROUND | RESPONSE_RECEIVED | MISSED_PING
  timestamp       DateTime @default(now())
  responseStatus  String   @default("RECEIVED") // RECEIVED | PENDING | EXPIRED | FAILED
  externalEventId String?  @unique
  metadata        String?  // JSON string
  createdAt       DateTime @default(now())

  owner           Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, timestamp])
}

model RecoveryAttempt {
  id           String                @id @default(uuid())
  ownerId      String
  initiatedAt  DateTime              @default(now())
  status       String                @default("PENDING") // PENDING | UNDER_REVIEW | APPROVED | REJECTED | CANCELLED | COMPLETED
  reason       String
  source       String                // GUARDIAN_INITIATED | AUTOMATIC_WATCH_ESCALATION | HEIR_REQUEST | etc.
  riskScore    Float                 @default(0.0)
  riskLevel    String                @default("UNKNOWN") // UNKNOWN | LOW | MEDIUM | HIGH
  cancelledAt  DateTime?
  cancelReason String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  owner        Owner                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  attestations GuardianAttestation[]
  riskEvents   RiskEvent[]
  alerts       Alert[]
  documents    ClaimDocument[]

  @@index([ownerId, status])
  @@index([status])
}

model ClaimDocument {
  id                 String           @id @default(uuid())
  recoveryAttemptId  String
  documentType       String           // DEATH_CERTIFICATE | MEDICAL_ATTESTATION | COURT_ORDER
  documentHash       String           // SHA-256 hash or IPFS CID
  issuingAuthority   String
  jurisdiction       String
  documentDate       DateTime
  receivedAt         DateTime         @default(now())
  submittedBy        String
  verificationStatus String           @default("PENDING_VERIFICATION") // PENDING_VERIFICATION | VERIFIED | REJECTED | FLAGGED_INCONSISTENCY
  rejectionReason    String?
  rawContent         String?          // Base64 or string content for server hash validation
  metadata           String?          // JSON metadata
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  recoveryAttempt    RecoveryAttempt  @relation(fields: [recoveryAttemptId], references: [id], onDelete: Cascade)

  @@index([recoveryAttemptId])
  @@index([verificationStatus])
}

model GuardianAttestation {
  id                String          @id @default(uuid())
  recoveryAttemptId String
  guardianId        String
  timestamp         DateTime        @default(now())
  status            String          @default("SUBMITTED") // PENDING | SUBMITTED | VALID | INVALID | REVOKED
  signature         String?
  metadata          String?         // JSON string
  createdAt         DateTime        @default(now())

  recoveryAttempt   RecoveryAttempt @relation(fields: [recoveryAttemptId], references: [id], onDelete: Cascade)

  @@unique([recoveryAttemptId, guardianId])
  @@index([recoveryAttemptId])
  @@index([guardianId])
}

model RiskEvent {
  id                String          @id @default(uuid())
  recoveryAttemptId String
  type              String          // TRIGGER_ANOMALY | GUARDIAN_COLLUSION | BEHAVIOR_DEVIATION | UNEXPECTED_LOCATION | ACCOUNT_RESET | DOCUMENT_ANOMALY
  severity          String          // LOW | MEDIUM | HIGH | CRITICAL
  score             Float
  timestamp         DateTime        @default(now())
  metadata          String?         // JSON string
  createdAt         DateTime        @default(now())

  recoveryAttempt   RecoveryAttempt @relation(fields: [recoveryAttemptId], references: [id], onDelete: Cascade)

  @@index([recoveryAttemptId, timestamp])
  @@index([type])
}

model Alert {
  id                String           @id @default(uuid())
  ownerId           String
  recoveryAttemptId String?
  type              String           // HEARTBEAT_REMINDER | HEARTBEAT_MISSED | WATCH_ENTERED | RECOVERY_INITIATED | GUARDIAN_ACTION_REQUIRED | HIGH_RISK_DETECTED
  severity          String           // INFO | WARNING | CRITICAL
  recipient         String
  channel           String           // EMAIL | SMS | WHATSAPP | PUSH | IN_APP
  status            String           @default("PENDING") // PENDING | SENT | FAILED | DISMISSED
  sentAt            DateTime?
  metadata          String?          // JSON string
  createdAt         DateTime         @default(now())

  owner             Owner            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  recoveryAttempt   RecoveryAttempt? @relation(fields: [recoveryAttemptId], references: [id], onDelete: SetNull)

  @@index([ownerId, status])
  @@index([ownerId, type, channel, status])
}

model AuditEvent {
  id         String   @id @default(uuid())
  eventType  String   // OWNER_CREATED | HEARTBEAT_RECEIVED | HEARTBEAT_MISSED | OWNER_ENTERED_WATCH | RECOVERY_INITIATED | GUARDIAN_ATTESTATION_RECEIVED | RISK_EVENT_CREATED | ALERT_SENT | OWNER_VETO_RECEIVED
  actorId    String
  actorType  String   // OWNER | GUARDIAN | SYSTEM | ADMIN
  timestamp  DateTime @default(now())
  entityId   String
  entityType String   // Owner | HeartbeatEvent | RecoveryAttempt | GuardianAttestation | RiskEvent | Alert
  metadata   String?  // JSON string
  createdAt  DateTime @default(now())

  /// Position in the anchored log (assigned when the record is anchored on-chain).
  anchorSeq     Int?              @unique
  anchorBatchId Int?
  anchorBatch   AuditAnchorBatch? @relation(fields: [anchorBatchId], references: [id])

  @@index([entityId])
  @@index([eventType])
  @@index([timestamp])
  @@index([anchorBatchId])
}

/// A batch of audit records whose Merkle root was committed to HeirloomAuditAnchor on-chain.
model AuditAnchorBatch {
  id        Int          @id // batchId in the HeirloomAuditAnchor contract
  root      String
  firstSeq  Int
  count     Int
  txHash    String
  contract  String
  chainId   Int
  createdAt DateTime     @default(now())

  records   AuditEvent[]
}

// ---------------------------------------------------------------------------
// Key escrow for sealed secrets (Member 1 crypto + Member 2 contract gate).
// The server only ever stores ciphertext: the secret is AES-encrypted in the
// owner's browser, its key is Shamir-split, and each share is RSA-encrypted
// to one guardian. Guardians re-encrypt their share to heirs only after the
// HeirloomVault reports isExecuted() == true.
// ---------------------------------------------------------------------------

/// A guardian's or heir's public encryption key, proven by a wallet signature.
model EscrowKey {
  id           String   @id @default(uuid())
  vaultAddress String
  address      String   // wallet address, lowercase
  role         String   // GUARDIAN | HEIR
  publicKey    String   // JWK (RSA-OAEP)
  signature    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([vaultAddress, address, role])
}

/// One sealed secret: AES-GCM ciphertext plus its Shamir threshold.
model SealedSecret {
  id           String         @id @default(uuid())
  vaultAddress String
  label        String
  asset        String         // EncryptedAsset JSON (ciphertext only)
  threshold    Int
  /// JSON array of heir addresses (lowercase) allowed to open this secret; null = every heir.
  recipients   String?
  createdAt    DateTime       @default(now())

  shares       EscrowShare[]

  @@index([vaultAddress])
}

/// A Shamir share encrypted to a guardian, or re-encrypted by that guardian to an heir.
model EscrowShare {
  id             String       @id @default(uuid())
  secretId       String
  guardian       String       // guardian address that holds/released this share, lowercase
  recipient      String       // address the ciphertext is encrypted to, lowercase
  kind           String       // HELD (to guardian) | RELEASED (guardian -> heir)
  encryptedShare String
  createdAt      DateTime     @default(now())

  secret         SealedSecret @relation(fields: [secretId], references: [id], onDelete: Cascade)

  @@unique([secretId, guardian, recipient, kind])
  @@index([recipient, kind])
}

// ---------------------------------------------------------------------------
// B2B2C: law firms and the client vaults they set up. On-chain truth (state,
// votes, balances) always comes from the vault; these rows hold the human
// metadata the contract deliberately does not store (names, contacts, notes).
// ---------------------------------------------------------------------------

model Firm {
  id         String       @id @default(uuid())
  wallet     String       @unique // lowercase; signs in by wallet signature
  name       String
  lawyerName String
  license    String?
  createdAt  DateTime     @default(now())

  clients    FirmClient[]
}

model FirmClient {
  id              String    @id @default(uuid())
  firmId          String
  vaultAddress    String    @unique // lowercase
  creationTx      String?
  clientName      String
  clientEmail     String?
  clientWallet    String    // lowercase
  heirs           String    // JSON: [{name, contact, wallet, percentage, relationship}]
  guardians       String    // JSON: [{name, contact, wallet, role}]
  executorLabel   String?
  assets          String    @default("[]") // JSON: AssetRecord[] (descriptions only, never secrets)
  onboardingToken String    @unique
  certStatus      String    @default("None") // None | Pending | Verified | Rejected
  certFileName    String?
  certHash        String?
  certUploadedBy  String?
  certUploadedAt  DateTime?
  certReviewedBy  String?
  certReviewedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  firm            Firm      @relation(fields: [firmId], references: [id])

  @@index([firmId])
  @@index([clientWallet])
}
