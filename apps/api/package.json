{
  "name": "heirloom-api",
  "version": "0.1.0",
  "private": true,
  "description": "Heirloom Base Backend - Owner Availability, Heartbeat, Recovery & Audit Engine",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean:test-db": "node scripts/clean-test-db.mjs",
    "predev": "npm run build -w @heirloom/shared && prisma generate",
    "pretest": "node scripts/clean-test-db.mjs && npm run build -w @heirloom/shared && prisma generate && cross-env DATABASE_URL=file:./test.db prisma migrate deploy",
    "prebuild": "npm run build -w @heirloom/shared && prisma generate"
  },
  "dependencies": {
    "@heirloom/shared": "*",
    "@prisma/client": "^6.4.1",
    "@simplewebauthn/server": "^13.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "viem": "^2.57.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@heirloom/crypto": "*",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.5",
    "@types/supertest": "^6.0.2",
    "cross-env": "^10.1.0",
    "prisma": "^6.4.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}