# Heirloom API Environment Configuration Example
PORT=4000
NODE_ENV=development
DATABASE_URL="file:./dev.db"
API_PREFIX="/api/v1"
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
AUTH_SECRET="heirloom-internal-secret-change-in-prod"
HEARTBEAT_SWEEP_INTERVAL_MS=60000
# On-chain integration (HeirloomVault on Sepolia, Member 2)
RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"
VAULT_CONTRACT_ADDRESS="0x43CfaE0d89b26A6dBB235Df788F8f030Ea239EA8"
CHAIN_WATCHER_ENABLED=true
CHAIN_POLL_INTERVAL_MS=12000
OWNER_ALERT_RECIPIENT="owner@heirloom.local"
OWNER_ALERT_CHANNEL="EMAIL"
# Audit-log anchoring (HeirloomAuditAnchor on Sepolia). Leave unset to disable.
ANCHOR_CONTRACT_ADDRESS=""
ANCHOR_PRIVATE_KEY=""   # a dedicated low-value key that only pays anchoring gas
ANCHOR_INTERVAL_MS=300000
# B2B2C relayer for gasless guardian votes (defaults to ANCHOR_PRIVATE_KEY's wallet)
RELAYER_PRIVATE_KEY=""
