# Copy to .env and fill in. NEVER commit .env.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<your-key>
ETHERSCAN_API_KEY=<your-etherscan-key>
PRIVATE_KEY=0x<deployer-private-key-with-sepolia-eth>

# Optional demo vault (short timers for the live pitch)
DEPLOY_DEMO_VAULT=true
DEMO_OWNER=0x...
DEMO_EXECUTOR=0x...
DEMO_GUARDIANS=0x...,0x...,0x...
DEMO_REQUIRED_SIGS=2
DEMO_HEIRS=0x...,0x...
DEMO_SHARES=6000,4000
DEMO_INACTIVITY_SECONDS=120
DEMO_VETO_SECONDS=180
DEMO_ASSET_MAP_CID=
